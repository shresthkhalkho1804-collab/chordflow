# ==============================================================================
# ChordFlow AI - Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in real credentials.
# The app works in local/offline mode with demo songs before keys are added.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# 1. Supabase (Database, Auth, Cloud Sync) — ESSENTIAL
# Get your project URL and keys from:
#   https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — NEVER expose in browser code (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# 2. Google Gemini AI — ESSENTIAL
# Get a key at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# 3. Self-Hosted / Local LLM (Ollama) — OPTIONAL
# Runs locally at http://localhost:11434/v1
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ==============================================================================
# 4. YouTube Data API v3 — OPTIONAL
# Enable at Google Cloud Console > APIs & Services
# ==============================================================================
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key
YOUTUBE_API_KEY=your_youtube_data_api_key

# ==============================================================================
# 5. Spotify Web API — OPTIONAL
# Create an app at: https://developer.spotify.com/dashboard
# Used for: Track search, metadata, 30s audio previews, Spotify links
# ==============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ==============================================================================
# 6. ACRCloud Music & Humming Recognition — OPTIONAL
# Sign up at: https://www.acrcloud.com/
# For humming: Requires a project with Humming/Melody Recognition enabled
# ==============================================================================
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key
ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret
ACRCLOUD_HUMMING_HOST=identify-eu-west-1.acrcloud.com

# ==============================================================================
# 7. AudD Music Recognition — OPTIONAL
# Alternative audio fingerprinting. Sign up at: https://audd.io/
# ==============================================================================
AUDD_API_TOKEN=your_audd_api_token

# ==============================================================================
# 8. Musixmatch — OPTIONAL
# Official lyrics API. Sign up at: https://developer.musixmatch.com/
# WARNING: Never scrape lyrics from unauthorized sources.
# ==============================================================================
MUSIXMATCH_API_KEY=your_musixmatch_api_key

# ==============================================================================
# 9. Google Cloud Project — OPTIONAL
# Speech-to-text cloud quota (Web Speech API is free and browser-native)
# ==============================================================================
GOOGLE_CLOUD_PROJECT_ID=your_project_id

# ==============================================================================
# 10. Essentia Audio Analysis — BUILT-IN (No API key required)
# Essentia.js (WASM) is bundled as an npm dependency.
# License: GNU AGPL-3.0 — See licensing note in README.
# For commercial closed-source distribution, a commercial license from
# MTG (Music Technology Group, UPF Barcelona) is required.
# Contact: https://essentia.upf.edu/licensing_information.html
# ==============================================================================
